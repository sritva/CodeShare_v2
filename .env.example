# Docker Compose reads this file after copying it to .env.
# Plain Maven does not load .env; export variables in your shell instead.
# .env is gitignored — never commit real credentials

MYSQL_ROOT_PASSWORD=rootpassword
MYSQL_USER=codeshare
MYSQL_PASSWORD=codeshare
# Required for Docker/MySQL: generate a random secret of at least 32 bytes.
JWT_SECRET=
# Optional: leave blank to run without AI explanations.
GEMINI_API_KEY=
